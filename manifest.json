{
  "manifest_version": 3,
  "name": "Vets SOAP Scribe (VSS)",
  "version": "2.2.0",
  "description": "獣医師向けAI音声カルテ作成アシスタント - SOAP形式自動生成",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
